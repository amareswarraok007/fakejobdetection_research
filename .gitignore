# Raw data, experiment outputs and exported models are never committed.
# The leading "/" anchors each pattern to the repository root. Without it, "data/"
# would also hide the code folders src/cvx/data/ and tests/data/.
/data/
/runs/
/runs_check/
/app/model_store/
/app/data/
# Streamlit secrets file, in case one is ever created (CLAUDE.md rule 12).
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tools
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
